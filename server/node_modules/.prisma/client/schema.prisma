generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  email          String          @unique
  name           String?
  password       String
  ageGroup       String
  goal           String
  coins          Int             @default(0)
  lightnings     Int             @default(0)
  progress       Progress[]
  lessonAttempts LessonAttempt[]
  portfolio      Portfolio[]
}

model Lesson {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  content        String
  order          Int
  progress       Progress[]
  lessonAttempts LessonAttempt[]
}

model Progress {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  user      User?   @relation(fields: [userId], references: [id])
  userId    String?
  lesson    Lesson? @relation(fields: [lessonId], references: [id])
  lessonId  String?
  completed Boolean @default(false)
}

model LessonAttempt {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  user          User     @relation(fields: [userId], references: [id])
  userId        String   @db.ObjectId
  lesson        Lesson?  @relation(fields: [lessonId], references: [id])
  lessonId      String?
  completed     Boolean  @default(false)
  lastAttempted DateTime @default(now())
  attempts      Int      @default(1)
}

model Portfolio {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  symbol    String
  shares    Float
  avgPrice  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------
// Lesson content (Mongo-backed) to replace code-based registry/steps
// We keep existing models above untouched to avoid breaking current routes

enum LessonType {
  info
  memorize
  test
  practice
}

model Step {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  stepNumber Int          @unique
  lessons    LessonMeta[]
}

model LessonMeta {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  numericId       Int        @unique
  title           String
  description     String     @default("")
  lessonType      LessonType
  unlockMinPoints Int?
  prerequisites   Int[]      @default([])

  step   Step?   @relation(fields: [stepId], references: [id])
  stepId String? @db.ObjectId

  sublessons Sublesson[]
}

model Sublesson {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  numericId   Int        @unique
  title       String
  description String     @default("")
  lessonType  LessonType

  lesson   LessonMeta? @relation(fields: [lessonId], references: [id])
  lessonId String?     @db.ObjectId
}

model LessonSteps {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  lessonNumericId Int      @unique
  stepsJson       Json
  updatedAt       DateTime @updatedAt
}
