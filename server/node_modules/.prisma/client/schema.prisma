generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  email      String      @unique
  name       String?
  password   String
  ageGroup   String
  goal       String
  coins      Int         @default(0)
  lightnings Int         @default(0)
  progress   Progress[]
  portfolio  Portfolio[]
}

model Lesson {
  id       String     @id @default(auto()) @map("_id") @db.ObjectId
  title    String
  content  String
  order    Int
  progress Progress[]
}

model Progress {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  user      User?   @relation(fields: [userId], references: [id])
  userId    String?
  lesson    Lesson? @relation(fields: [lessonId], references: [id])
  lessonId  String?
  completed Boolean @default(false)
}

model Portfolio {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  symbol    String
  shares    Float
  avgPrice  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
