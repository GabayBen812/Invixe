# Copy to .env in this folder for local native builds (npm run ios / android)
# OAuth client IDs are public — not secrets.

# Web client ID — required for Google Sign-In on iOS and Android
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=759410396991-m1hml4a6rvhr4vijbpdprtlt6jea1a8v.apps.googleusercontent.com

# iOS client ID — required for Google Sign-In on iOS
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=759410396991-isd85q017726sp6drgtdftdao23abvdd.apps.googleusercontent.com

# Android client ID — optional if web client + SHA-1 fingerprint are configured in Google Cloud
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
