{
  "expo": {
    "name": "invixe-app",
    "slug": "invixe-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",

    "splash": {
      "image": "./src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.gabayben812.invixeapp",
      "supportsRtl": false
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": ["expo-font", "expo-asset", "./plugins/withForceLtr.js"],
    "extra": {
      "eas": {
        "projectId": "c380a02c-446d-4cfc-9f03-b468227a3406"
      }
    }
  }
}
