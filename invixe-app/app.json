{
  "expo": {
    "name": "Invixe",
    "slug": "invixe-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/InvixeLogo.png",
    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/InvixeLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#E3EEF9"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gabayben812.invixeapp"
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/InvixeLogo.png",
        "backgroundColor": "#E3EEF9"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.gabayben812.invixeapp",
      "supportsRtl": false
    },

    "web": {
      "favicon": "./assets/InvixeLogo.png"
    },

    "plugins": [
      "expo-font",
      "expo-asset",
      "./plugins/withForceLtr.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Invixe צריכה גישה לתמונות כדי להגדיר תמונת פרופיל."
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "c380a02c-446d-4cfc-9f03-b468227a3406"
      }
    }
  }
}